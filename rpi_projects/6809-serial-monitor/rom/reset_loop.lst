     FFFFFFFFFF
                      
                              ; 6809 Interrupt and Reset Vectors (at top of memory)
FFF0                          ORG     $FFF0
FFF0 E000                     FDB     RESET           ; Reserved
FFF2 E000                     FDB     RESET           ; SWI3
FFF4 E000                     FDB     RESET           ; SWI2  
FFF6 E000                     FDB     RESET           ; FIRQ
FFF8 E000                     FDB     RESET           ; IRQ
FFFA E000                     FDB     RESET           ; SWI
FFFC E000                     FDB     RESET           ; NMI
FFFE E000                     FDB     RESET           ; RESET vector at $FFFE-$FFFF
                      
0000                          END
