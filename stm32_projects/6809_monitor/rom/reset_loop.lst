E000                          ORG     $E000           ; Our actual code starts here
                      
E000                  RESET:  
                              ; Initialize stack pointer (optional but good practice)
E000 10CE7FFF                 LDS     #$7FFF          ; Set stack to top of RAM (adjust for your system)
                              
E004                  MAIN:   
                              ; Load easily identifiable values into registers
E004 86AA                     LDA     #$AA            ; Load A register with 0xAA (10101010 binary)
E006 C655                     LDB     #$55            ; Load B register with 0x55 (01010101 binary)
E008 8E1234                   LDX     #$1234          ; Load X register with 0x1234
E00B 108EABCD                 LDY     #$ABCD          ; Load Y register with 0xABCD
                              
                              ; Perform some operations to see activity
E00F 4C                       INCA                    ; Increment A (AA -> AB)
E010 5A                       DECB                    ; Decrement B (55 -> 54)
E011 3001                     LEAX    1,X             ; Add 1 to X (1234 -> 1235)
E013 313F                     LEAY    -1,Y            ; Subtract 1 from Y (ABCD -> ABCC)
                              
                              ; Transfer between registers for more bus activity
E015 1F89                     TFR     A,B             ; Transfer A to B
E017 1E12                     EXG     X,Y             ; Exchange X and Y
                              
                              ; Store and load from memory to create memory access patterns
E019 B78100                   STA     $8100           ; Store A at a known location
E01C F68100                   LDB     $8100           ; Load it back into B
                              
                              ; Jump back to main loop
E01F 7EE004                   JMP     MAIN            ; Continue the loop
                              
                              ; Fill remaining space with zeros
E022 0000000000000000         FILL    $00,$FFF0-*     ; Fill with zeros until interrupt vectors
